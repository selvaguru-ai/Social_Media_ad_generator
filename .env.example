# Meta Ad Library API
# Get your access token from: https://developers.facebook.com/
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# Contact Enrichment API (choose one or more)
# Apollo: https://apollo.io/
APOLLO_API_KEY=your_apollo_api_key_here

# Hunter.io: https://hunter.io/
HUNTER_API_KEY=your_hunter_api_key_here

# Clearbit: https://clearbit.com/
CLEARBIT_API_KEY=your_clearbit_api_key_here

# Higgsfield API for video generation
# Get credentials from: https://cloud.higgsfield.ai/
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here
HIGGSFIELD_BASE_URL=https://cloud.higgsfield.ai/api

# Email sending (for outreach agent)
# Use a transactional email service (SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SENDER_EMAIL=your_sender@example.com
SENDER_NAME=Your Name

# Optional: Database
DATABASE_URL=sqlite:///./data/pipeline.db

# Optional: Business data sources
CRUNCHBASE_API_KEY=your_crunchbase_key_here
